# Copy to .env and fill in. Authoritative meaning of each variable:
# ../../docs/CONFIGURATION.md

# --- Required ---------------------------------------------------------------

# Postgres password for the shared state/coordination database.
POSTGRES_PASSWORD=guardian

# 64-hex (32-byte) key signing dashboard pagination cursors. MUST be identical
# on every replica. Generate with: openssl rand -hex 32
GUARDIAN_DASHBOARD_CURSOR_SECRET=

# Miden network the replicas target. MidenTestnet matches the production
# deployment (infra defaults server_network_type to MidenTestnet), so write-path
# and canonicalization timings stay comparable to the authoritative tier.
GUARDIAN_NETWORK_TYPE=MidenTestnet

# --- Baseline values for the variables under test ----------------------------
# Defaults below mirror the server's code defaults, NOT the prod Terraform
# profile — prod sets pool 32 and canonicalization concurrency 50. Start from
# code defaults so a variant sweep covers the prod values as data points rather
# than assuming them. Override one at a time via variants/*.env.

GUARDIAN_DB_POOL_MAX_SIZE=16
GUARDIAN_METADATA_DB_POOL_MAX_SIZE=16
GUARDIAN_CANONICALIZATION_MAX_CONCURRENT_ACCOUNTS=10
GUARDIAN_CANONICALIZATION_FAST_PROMOTION_ENABLED=true

# Replica capacity the rate limiter divides global limits by. Must match the
# number of running server-* services, or per-replica limits are wrong.
GUARDIAN_MAX_REPLICAS=2

# --- Resource budget ---------------------------------------------------------
# Totals ~6.0 CPUs. On a 10-core host that leaves ~4 for a host-side load
# generator. Raise these only if you also confirm the generator still has
# headroom — a generator-bound run produces no bottleneck claim.

POSTGRES_CPUS=2.0
POSTGRES_MEM=2g
POSTGRES_MAX_CONNECTIONS=200

# Host port for Postgres. Default avoids 5432, which the repo's own
# docker-compose.postgres.yml and most local installs already bind.
POSTGRES_HOST_PORT=55432
SERVER_CPUS=1.5
SERVER_MEM=1500m
PROXY_CPUS=1.5
PROMETHEUS_CPUS=0.25
GRAFANA_CPUS=0.25

# --- Instrumentation ---------------------------------------------------------

GUARDIAN_METRICS_BEARER_TOKEN=devtoken
GUARDIAN_METRICS_REFRESH_INTERVAL_SECS=15

# `warn` keeps logging off the measured path. Raise to `info` when debugging the
# stack itself, never during a run you intend to report.
GUARDIAN_LOG_LEVEL=warn

# --- Rate limiting -----------------------------------------------------------
# Prod-equivalent values. gRPC never traverses the rate-limit layer, so these
# have no effect on a gRPC run; they exist so the stack stays comparable to
# production and so an HTTP leg starts from prod behaviour.

GUARDIAN_RATE_BURST_PER_SEC=200
GUARDIAN_RATE_PER_MIN=5000
