# April benchmark deployment shape: 2 vCPU / 4 GB per task, pool 32,
# canonicalization concurrency 50. Terraform's own defaults are smaller
# (server_cpu = 512, server_memory = 1024), but the April run overrode them and
# it is the only prod baseline that exists -- so this is the shape that makes
# results comparable to it.
#
# The stack's own defaults are the server's CODE defaults (pool 16, canon 10),
# which understate what prod is configured to do.
SERVER_CPUS=2.0
SERVER_MEM=4g
GUARDIAN_DB_POOL_MAX_SIZE=32
GUARDIAN_METADATA_DB_POOL_MAX_SIZE=32
GUARDIAN_CANONICALIZATION_MAX_CONCURRENT_ACCOUNTS=50
