# Read-path leg sized so the generator has cores of its own.
#
# Total container allocation here is 5.0 of 10 physical cores, leaving ~5 for
# the load generator. The default shape allocates 8, which left the generator
# competing for 2 and produced host load 15.9 -- a leg that measured the
# machine rather than GUARDIAN.
SERVER_CPUS=1.0
SERVER_MEM=2g
POSTGRES_CPUS=1.5
PROXY_CPUS=1.0
PROMETHEUS_CPUS=0.25
GRAFANA_CPUS=0.25
