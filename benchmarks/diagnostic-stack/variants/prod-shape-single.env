# Same per-task shape as prod-shape.env, one replica. Pair with
# `--scale server-b=0`. GUARDIAN_MAX_REPLICAS must match the running count or
# per-replica rate-limit partitioning is computed against a fleet that does not
# exist.
SERVER_CPUS=2.0
SERVER_MEM=4g
GUARDIAN_DB_POOL_MAX_SIZE=32
GUARDIAN_METADATA_DB_POOL_MAX_SIZE=32
GUARDIAN_CANONICALIZATION_MAX_CONCURRENT_ACCOUNTS=50
GUARDIAN_MAX_REPLICAS=1
