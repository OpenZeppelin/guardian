# Policy modules guide: a local server on the filesystem backend.
# Copy to .env next to this file, then load it before starting the server:
#   set -a && . docs/guides/policy-modules/.env && set +a
# Paths are relative to the repository root, where you start the server.
GUARDIAN_ENV=dev
GUARDIAN_NETWORK_TYPE=MidenDevnet
GUARDIAN_STORAGE_PATH=.guardian/modules-guide/storage
GUARDIAN_METADATA_PATH=.guardian/modules-guide/metadata
GUARDIAN_KEYSTORE_PATH=.guardian/modules-guide/keystore
GUARDIAN_OPERATOR_PUBLIC_KEYS_FILE=.guardian/operators.json
# One of built-in.toml, remote.toml or custom.toml, copied into .guardian/.
GUARDIAN_MODULES_CONFIG=.guardian/built-in.toml
