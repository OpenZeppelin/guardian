# Configuration for ./docker-compose.yml. Copy to `.env` (gitignored) and run
# from this directory:
#   docker compose up
#
# Everything here is OPTIONAL — the stack runs with sensible defaults and no
# .env at all. Uncomment to override.
#
# Walkthrough: ./README.md
# Full server config reference: ../../CONFIGURATION.md

# Miden network the server targets (server default: MidenDevnet). The server
# connects to this network's RPC at startup, so it needs outbound internet.
# NOTE: the selected network must run the Miden line this workspace targets
# (currently the 0.16 pre-release line; devnet already runs it, testnet
# upgrades on its own cadence). A mismatched node is rejected at the RPC
# boundary — see docs/TROUBLESHOOTING.md.
# GUARDIAN_NETWORK_TYPE=MidenTestnet

# Server log level.
# RUST_LOG=info

# NOTE: the metrics scrape token is fixed to `devtoken` for this local stack
# (set in docker-compose.yml and prometheus/prometheus.yml). If you change it,
# change it in BOTH places — Prometheus does not read it from .env.
