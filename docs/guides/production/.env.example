# Self-managed production Guardian (Track B of ./README.md): the published
# Docker image with NO AWS dependency. Copy to `.env` (gitignored), fill in, and
# run from this directory:
#   docker compose up -d
#
# This file is the server container's env_file and the only place operator
# values live: the compose file never interpolates a server variable, so an
# exported shell variable cannot override what is set here (Compose reads the
# shell only for GUARDIAN_VERSION and the host port/bind settings below, where
# the shell wins). It is also the basis of what `docker run --env-file .env ...`
# or a Kubernetes Secret would carry (those also need the values
# docker-compose.yml fixes in `environment:`; README.md, end of Track B). Treat it as secret material: it holds the cursor
# secret, the metrics token, and (with the bundled DB) the database password.
# Full server config reference: ../../CONFIGURATION.md
#
# Other tracks: ./.env.aws-ecs.example (AWS ECS/Fargate via Terraform) and
# ./.env.aws-no-ecs.example (Docker image + AWS Secrets Manager/KMS custody).

# Required: pin an explicit published release LATER THAN v0.17.0. This stack
# relies on server features v0.17.0 lacks (ack-keygen in the image, the
# storage-encryption key file, GUARDIAN_ALLOWED_ACCOUNT_SCHEMES, prod-stage
# defaults); an older image boots anyway and silently stores PLAINTEXT. Left
# blank on purpose: Compose refuses to start until you set it. Guardian 0.17.x
# runs on Miden 0.16 (../../MIDEN_COMPATIBILITY.md). Never run `latest`.
GUARDIAN_VERSION=

# Required: Miden network the server targets. The server refuses to start when
# this is unset or unrecognized. MidenTestnet | MidenDevnet | MidenLocal.
GUARDIAN_NETWORK_TYPE=MidenTestnet

# --- Database ---------------------------------------------------------------
# Production: your own Postgres, reached over verified TLS. Mount the provider's
# CA bundle (see the commented volume in docker-compose.yml) and replace
# DATABASE_URL below with:
# DATABASE_URL=postgres://USER:PASSWORD@db.example.com:5432/guardian?sslmode=verify-full&sslrootcert=/etc/guardian/tls/ca.pem
#
# Evaluation: the bundled Postgres in docker-compose.yml (no backups, no TLS).
# The two values must agree: POSTGRES_PASSWORD initializes the bundled database
# on first run, DATABASE_URL is what the server dials. URL-safe characters only.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://guardian:change-me@postgres:5432/guardian

# --- Guardian identity (ACK signing keys) -------------------------------------
# The compose file declares ./ack-keys/* (two 0600 files written by the image's
# ack-keygen) as Compose secrets and sets GUARDIAN_ACK_SECRET_PROVIDER=file.
# Nothing to set here; see README.md, Track B step 1. Losing or regenerating
# those files changes Guardian's identity.

# --- Storage encryption at rest (enable against an EMPTY store) ---------------
# The compose file mounts ./storage-encryption-keys.json, a
# {"active": kid, "keys": {kid: base64-32-bytes}} document, as a Compose secret
# and points GUARDIAN_STORAGE_ENCRYPTION_KEY_FILE at it. Nothing to set here;
# see README.md, Track B step 2. Rotation is adding a key and repointing
# "active". Back the file up with the database: ciphertext is unreadable
# without it.

# --- Dashboard ---------------------------------------------------------------
# Required: 32-byte hex (64 chars) signing key for dashboard pagination cursors.
# Pin one value and reuse it on every replica: openssl rand -hex 32
GUARDIAN_DASHBOARD_CURSOR_SECRET=replace-with-64-hex-chars
# The operator allowlist is the mounted ./operators.json (object entries with
# explicit permissions; hot-reloaded, no restart). See README.md, Track B step 2.

# --- Account signature scheme ---------------------------------------------------
# Schemes NEW accounts may register with (falcon, ecdsa). Recommended: ecdsa,
# the scheme with hosted-signer (KMS) support; Falcon is second-class. Applies
# to new registrations only: existing accounts keep their scheme for life, and
# both ACK keys are still required. Unset or blank allows both.
GUARDIAN_ALLOWED_ACCOUNT_SCHEMES=ecdsa

# --- Browser clients ----------------------------------------------------------
# Required for production browser clients: exact origins, comma-separated
# (wildcards rejected). Unset -> permissive Any origin with credentials disabled.
GUARDIAN_CORS_ALLOWED_ORIGINS=https://accounts.example.com

# --- Metrics (Prometheus) ------------------------------------------------------
# The compose file publishes :9464 on 127.0.0.1 only. Keep it off the public
# internet and gate scrapes with the bearer token (openssl rand -hex 32).
GUARDIAN_METRICS_ENABLED=true
GUARDIAN_METRICS_BEARER_TOKEN=change-me

# --- Ingress binding -----------------------------------------------------------
# Host interface the HTTP/gRPC ports are published on. Default 127.0.0.1 (an
# ingress on this host). Set to the private ingress-facing IP, never a public
# one, when the load balancer runs on another machine. These, and
# GUARDIAN_VERSION, are read by Compose interpolation, where an exported shell
# variable of the same name takes precedence over this file.
# GUARDIAN_BIND_ADDR=127.0.0.1
# GUARDIAN_HTTP_PORT=3000
# GUARDIAN_GRPC_PORT=50051
# GUARDIAN_METRICS_PORT=9464

# --- Replicas ------------------------------------------------------------------
# Must equal the number of server replicas sharing this database (README.md,
# Track B step 7). Each replica enforces global / GUARDIAN_MAX_REPLICAS.
GUARDIAN_MAX_REPLICAS=1

# --- Production defaults (applied by GUARDIAN_ENV=prod, override to tune) -------
# With GUARDIAN_ENV=prod the server starts with the production profile: 200
# req/s burst per IP and endpoint, 5000 req/min per IP across HTTP and gRPC,
# 32 connections per pool (two pools per replica), 50 concurrent accounts per
# canonicalization pass, JSON logs. Set a variable only to change it.
# GUARDIAN_RATE_BURST_PER_SEC=200
# GUARDIAN_RATE_PER_MIN=5000
# GUARDIAN_DB_POOL_MAX_SIZE=32
# GUARDIAN_METADATA_DB_POOL_MAX_SIZE=32
# GUARDIAN_CANONICALIZATION_MAX_CONCURRENT_ACCOUNTS=50
# GUARDIAN_LOG_FORMAT=json

# --- Optional tuning -----------------------------------------------------------
# Miden node: a self-hosted node or private RPC mirror (origin-only URL).
# GUARDIAN_MIDEN_RPC_ENDPOINT=https://rpc.example.com
# GUARDIAN_MIDEN_RPC_TIMEOUT_MS=10000
# GUARDIAN_MIDEN_RPC_MAX_ATTEMPTS=1
