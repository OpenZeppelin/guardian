# Self-hosted, production-parity Guardian via Docker Compose, using AWS for
# secret custody (Secrets Manager + KMS). Copy to `.env` (gitignored) and run
# from this directory:
#   docker compose up
#
# This is the Docker Compose track of the production guide — see the
# "Self-hosted via Docker Compose" section in ./README.md. It runs a single
# server replica with GUARDIAN_ENV=prod, so every prod-stage guard is active.
# Multi-replica HA is the ECS track (steps 1–4 of ./README.md).
#
# Full server config reference: ../../CONFIGURATION.md

# Required: password for the bundled Postgres. Set a strong value and keep it
# stable — the data volume is initialized with it on first run. URL-safe only;
# it is embedded verbatim in DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Required: AWS region holding the Secrets Manager secrets and the KMS key.
AWS_REGION=us-east-1

# Required: AWS credentials for the container. Easiest for a single host is to
# export these in your shell before `docker compose up` (Compose passes them
# through). A long-lived host should use an instance/container role instead —
# leave these blank then.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Required: Secrets Manager name/ARN of the Falcon ACK key. Create with:
#   ./scripts/aws-deploy.sh bootstrap-ack-keys   (with a KMS ARN exported)
GUARDIAN_ACK_FALCON_SECRET_ID=guardian/server/ack-falcon-secret-key

# Required: KMS key id/ARN/alias for the ECDSA ACK signer (ECC_SECG_P256K1 /
# SIGN_VERIFY). Create with: ./scripts/aws-deploy.sh bootstrap-kms-ecdsa-key
GUARDIAN_ACK_ECDSA_KMS_KEY_ID=alias/guardian-ack-ecdsa

# Required: Secrets Manager name/ARN of the storage-encryption key document.
# Create with: ./scripts/aws-deploy.sh bootstrap-storage-encryption-key
# Enable against an EMPTY store only (the bundled Postgres is empty on first run).
GUARDIAN_STORAGE_ENCRYPTION_KEY_SECRET_ID=guardian/server/storage-encryption-key

# Required in the prod stage: 32-byte hex (64 chars). Pinned so dashboard
# pagination cursors validate; the server refuses to start in prod if unset.
# Generate: openssl rand -hex 32
GUARDIAN_DASHBOARD_CURSOR_SECRET=replace-with-64-hex-chars

# Required for production browser clients: exact origins (comma-separated,
# wildcards rejected). Unset → permissive Any with credentials disabled.
GUARDIAN_CORS_ALLOWED_ORIGINS=https://accounts.example.com

# Network the server targets.
GUARDIAN_NETWORK_TYPE=MidenTestnet

# Optional: Prometheus metrics on :9464 (gated by a bearer token; keep the port
# off the public internet in real deployments).
GUARDIAN_METRICS_ENABLED=true
GUARDIAN_METRICS_BEARER_TOKEN=change-me

# Optional: dashboard operator allowlist secret (Secrets Manager name/ARN).
# GUARDIAN_OPERATOR_PUBLIC_KEYS_SECRET_ID=guardian/server/operators

# Optional: published image version to run (default: latest).
# GUARDIAN_VERSION=v1.2.3
