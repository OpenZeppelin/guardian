# ECS / Terraform (AWS) deploy track of the production guide — steps 1–4 of
# ./README.md. Copy to `.env.prod` (gitignored), fill in, then source it before
# every bootstrap / plan / deploy:
#   cp .env.prod.example .env.prod
#   set -a && source .env.prod && set +a
#   ./scripts/aws-deploy.sh deploy
#
# This is NOT the Docker Compose track. The database here is RDS, provisioned and
# credentialed by Terraform (DATABASE_URL lives in Secrets Manager / RDS Proxy),
# so there is no POSTGRES_PASSWORD. For the single-host Docker Compose track
# (bundled Postgres), use ./.env.example instead.
#
# The `prod` stage profile already sets GUARDIAN_ENV=prod, the required
# GUARDIAN_DASHBOARD_CURSOR_SECRET, the rate-limit bumps, RDS Proxy, and
# autoscaling — do NOT set those here. Full reference: ../../CONFIGURATION.md

# Required: stage, stack identity, region, network.
DEPLOY_STAGE=prod
# STACK_NAME must be unique per environment — never reuse a stg/prod stack name,
# or you collide with its resources and local Terraform state.
STACK_NAME=guardian-prod
AWS_REGION=us-east-1
GUARDIAN_NETWORK_TYPE=MidenTestnet

# Required: Cargo features for the image build. `postgres`, or `postgres,evm`.
GUARDIAN_SERVER_FEATURES=postgres

# AWS credentials for the deploy shell. Prefer an assumed role / SSO session;
# uncomment for static keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Storage encryption at rest (recommended; enable against an EMPTY store).
# Bootstrap first: ./scripts/aws-deploy.sh bootstrap-storage-encryption-key
# This is the NAME (not the ARN) — Terraform resolves the ARN. Setting it is the
# on-switch; unset leaves storage plaintext. Default name shown.
GUARDIAN_STORAGE_ENCRYPTION_SECRET_NAME=guardian-prod/server/storage-encryption-key

# KMS-backed ECDSA ACK key (recommended). Export this BEFORE bootstrap-ack-keys
# (so it skips the ECDSA Secrets Manager secret) and before deploy.
# TF_VAR_guardian_ack_ecdsa_kms_key_arn=arn:aws:kms:us-east-1:...:key/...

# Verified DB TLS (verify-full). Build the CA bundle + secret per
# ../../SERVER_AWS_DEPLOY.md#database-tls-verification, then set its ARN.
# TF_VAR_rds_ca_bundle_secret_arn=arn:aws:secretsmanager:us-east-1:...:secret:guardian-prod/server/rds-ca-bundle

# Required for production browser clients: exact origins, comma-separated
# (wildcards rejected). Unset → permissive Any with credentials disabled.
GUARDIAN_CORS_ALLOWED_ORIGINS=https://accounts.example.com

# Dashboard operator allowlist (if the dashboard is enabled) — pick one.
# Bare-key JSON grants dashboard:read only:
# GUARDIAN_OPERATOR_PUBLIC_KEYS_JSON='["0x<alice-falcon-public-key>","0x<bob-falcon-public-key>"]'
# Externally-managed secret with object entries is the only path that can grant
# accounts:pause (takes precedence over the JSON list):
# GUARDIAN_OPERATOR_PUBLIC_KEYS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:...:secret:guardian-prod/server/operators

# DNS / TLS at the ALB. WARNING: DOMAIN_NAME defaults to `openzeppelin.com` and
# SUBDOMAIN to `guardian` when UNSET. Set them empty here so a demo / non-prod
# stack creates NO Route53/Cloudflare records and you reach it via the raw ALB
# DNS name. For real prod, set the domain + ACM cert (and Cloudflare, if used).
DOMAIN_NAME=
SUBDOMAIN=
# ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:...:certificate/...
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# Optional image overrides.
# ECR_REPO_NAME=guardian-prod-server   # default: <stack-name>-server
# CPU_ARCHITECTURE=X86_64              # or ARM64

# Optional: Prometheus metrics. Keep :9464 off the public internet; gate with the
# bearer token. See ../observability/README.md.
# GUARDIAN_METRICS_ENABLED=true
# GUARDIAN_METRICS_ADDR=0.0.0.0:9464
# GUARDIAN_METRICS_BEARER_TOKEN=change-me
