# AWS ECS/Fargate track (Track A of ./README.md): drives scripts/aws-deploy.sh
# and the Terraform in infra/. Copy to `.env.aws-ecs` (gitignored), fill in, then
# source it before EVERY bootstrap / build / plan / deploy command:
#   cp docs/guides/production/.env.aws-ecs.example .env.aws-ecs
#   set -a && source .env.aws-ecs && set +a
#   ./scripts/aws-deploy.sh plan
#
# This is NOT a Docker Compose env file. The database is RDS, provisioned and
# credentialed by Terraform (DATABASE_URL is assembled from the RDS secret and
# RDS Proxy), so nothing here holds a database password. For the Docker tracks
# use ./.env.example (self-managed) or ./.env.aws-no-ecs.example.
#
# The `prod` stage profile already sets GUARDIAN_ENV=prod, injects the
# bootstrapped dashboard cursor secret, GUARDIAN_MAX_REPLICAS, the rate-limit
# and pool bumps, RDS Proxy, autoscaling, JSON logs, and the CloudWatch metrics
# pipeline. Do not set those here. Full reference: ../../CONFIGURATION.md

# --- Stack identity ------------------------------------------------------------
DEPLOY_STAGE=prod
# Unique per environment: never reuse a staging stack name, or you collide with
# its resources and local Terraform state.
STACK_NAME=guardian-prod
# Region for the secrets, the KMS key, and every stack resource. Set before
# running any bootstrap command.
AWS_REGION=us-east-1
# Required by the server: MidenTestnet | MidenDevnet | MidenLocal.
GUARDIAN_NETWORK_TYPE=MidenTestnet

# Cargo feature for the image build: `postgres` (the production storage backend).
GUARDIAN_SERVER_FEATURES=postgres

# AWS credentials for the deploy shell. Prefer an assumed role / SSO session;
# uncomment only for static keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Secrets bootstrapped once per stack (README step A1) ----------------------
# KMS-backed ECDSA ACK key (recommended). Export BEFORE bootstrap-ack-keys (so
# it creates only the Falcon secret) and before every plan/deploy. Printed by
# bootstrap-kms-ecdsa-key.
# TF_VAR_guardian_ack_ecdsa_kms_key_arn=arn:aws:kms:us-east-1:123456789012:key/<key-id>

# Storage encryption at rest (recommended; enable against an EMPTY store).
# Bootstrap first: ./scripts/aws-deploy.sh bootstrap-storage-encryption-key
# This is the secret NAME (Terraform resolves the ARN). Setting it is the
# on-switch; unset leaves storage plaintext. Default name shown.
GUARDIAN_STORAGE_ENCRYPTION_SECRET_NAME=guardian-prod/server/storage-encryption-key

# Verified database TLS (verify-full). Build the combined CA bundle and its
# secret per ../../SERVER_AWS_DEPLOY.md#database-tls-verification, then set the
# ARN. Unset keeps sslmode=require (encrypted, certificate not verified).
# TF_VAR_rds_ca_bundle_secret_arn=arn:aws:secretsmanager:us-east-1:123456789012:secret:guardian-prod/server/rds-ca-bundle

# Dashboard cursor secret: bootstrapped with bootstrap-dashboard-cursor-secret,
# default name <stack>/server/dashboard-cursor-secret. Override only if you
# named it differently.
# GUARDIAN_DASHBOARD_CURSOR_SECRET_NAME=guardian-prod/server/dashboard-cursor-secret

# Dashboard operator allowlist (if the dashboard is used); pick one.
# Bare-key JSON, Terraform creates the secret, grants dashboard:read only:
# GUARDIAN_OPERATOR_PUBLIC_KEYS_JSON='["0x<alice-falcon-public-key>","0x<bob-falcon-public-key>"]'
# Externally-managed secret with object entries: the only path that can grant
# accounts:pause; takes precedence over the JSON list.
# GUARDIAN_OPERATOR_PUBLIC_KEYS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:guardian-prod/server/operators

# --- Runtime -------------------------------------------------------------------
# Required for production browser clients: exact origins, comma-separated
# (wildcards rejected). Unset -> permissive Any origin, credentials disabled.
GUARDIAN_CORS_ALLOWED_ORIGINS=https://accounts.example.com
# Schemes NEW accounts may register with (falcon, ecdsa). Recommended: ecdsa,
# the scheme with KMS support; Falcon is second-class. New registrations only:
# existing accounts keep their scheme, and the Falcon ACK key stays required.
# Terraform variable: guardian_allowed_account_schemes. Unset allows both.
GUARDIAN_ALLOWED_ACCOUNT_SCHEMES=ecdsa

# --- HTTPS and DNS at the ALB --------------------------------------------------
# Terraform defaults the public hostname to guardian.openzeppelin.com whenever
# DOMAIN_NAME / SUBDOMAIN are unset OR empty in this shell (the script passes
# them only when non-empty), so always set your own hostname here. What gets
# created is gated separately: DNS records only when ROUTE53_ZONE_ID or
# CLOUDFLARE_ZONE_ID is set; HTTPS (and gRPC through the ALB on :443) only when
# ACM_CERTIFICATE_ARN is set. With no certificate the ALB serves plain HTTP on
# its raw DNS name (`status` prints it as alb_url) and gRPC is not routed.
DOMAIN_NAME=example.com
SUBDOMAIN=guardian
# ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/<id>
# ROUTE53_ZONE_ID=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_PROXIED=true

# --- Optional Terraform overrides (TF_VAR_* passes straight through) -----------
# Alerting destination for the CloudWatch alarms the stack creates. Without it
# the alarms exist but notify nobody.
# TF_VAR_alarm_actions='["arn:aws:sns:us-east-1:123456789012:guardian-alerts"]'
# Standby failover for RDS (off by default in every stage; roughly doubles the
# instance cost). Backups, deletion protection, and the final snapshot are
# already on in prod.
# TF_VAR_rds_multi_az=true
# Capacity: prod defaults are desired 2, autoscaling 2..6, db.r6g.large.
# TF_VAR_server_desired_count=2
# TF_VAR_server_autoscaling_max_capacity=6
# TF_VAR_rds_instance_class=db.r6g.large
# Rate limits (prod defaults 200 / 5000). GUARDIAN_RATE_PER_MIN is per IP across
# HTTP and gRPC together; each task enforces global / GUARDIAN_MAX_REPLICAS.
# TF_VAR_guardian_rate_burst_per_sec=200
# TF_VAR_guardian_rate_per_min=5000
# Metrics pipeline (both default true). guardian_metrics_enabled=false turns
# the endpoint and the CloudWatch export off together.
# TF_VAR_guardian_metrics_enabled=true
# TF_VAR_cloudwatch_metrics_enabled=true

# --- Optional image overrides --------------------------------------------------
# ECR_REPO_NAME=guardian-prod-server   # default: <stack-name>-server
# CPU_ARCHITECTURE=X86_64              # or ARM64
