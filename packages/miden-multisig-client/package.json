{
  "name": "@openzeppelin/miden-multisig-client",
  "version": "0.17.0",
  "description": "TypeScript SDK for Miden multisig accounts with GUARDIAN integration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenZeppelin/guardian.git",
    "directory": "packages/miden-multisig-client"
  },
  "homepage": "https://github.com/OpenZeppelin/guardian/tree/main/packages/miden-multisig-client#readme",
  "bugs": {
    "url": "https://github.com/OpenZeppelin/guardian/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "masm",
    "!dist/testing",
    "!src/testing",
    "!dist/**/*.test.*",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:qualification": "vitest run --config vitest.qualification.config.ts"
  },
  "dependencies": {
    "@miden-sdk/miden-sdk": "0.17.0-rc.3",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.0.1",
    "@openzeppelin/guardian-client": "^0.17.0"
  },
  "devDependencies": {
    "@openzeppelin/guardian-operator-client": "^0.17.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.13.5",
    "fake-indexeddb": "^6.2.5",
    "viem": "^2.47.5",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
