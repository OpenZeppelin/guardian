{
  "name": "@openzeppelin/guardian-client",
  "version": "0.17.0-rc.3",
  "description": "TypeScript HTTP client for Guardian server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenZeppelin/guardian.git",
    "directory": "packages/guardian-client"
  },
  "homepage": "https://github.com/OpenZeppelin/guardian/tree/main/packages/guardian-client#readme",
  "bugs": {
    "url": "https://github.com/OpenZeppelin/guardian/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
