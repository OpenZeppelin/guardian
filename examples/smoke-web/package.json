{
  "name": "miden-multisig-smoke-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:sdk": "npm --prefix ../../packages run build -w @openzeppelin/guardian-client && npm --prefix ../../packages run build -w @openzeppelin/miden-multisig-client",
    "predev": "npm run build:sdk",
    "dev": "vite",
    "prebuild": "npm run build:sdk",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run build:sdk",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@demox-labs/miden-wallet-adapter-base": "^0.10.0",
    "@demox-labs/miden-wallet-adapter-miden": "^0.10.0",
    "@miden-sdk/miden-sdk": "0.16.0-rc.5",
    "@openzeppelin/guardian-client": "file:../../packages/guardian-client",
    "@openzeppelin/miden-multisig-client": "file:../../packages/miden-multisig-client",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.8"
  }
}
