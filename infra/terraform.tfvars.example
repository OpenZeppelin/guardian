# Required: AWS region
aws_region = "us-east-1"

# Optional: ECS/image architecture
# cpu_architecture = "X86_64"
# cpu_architecture = "ARM64"

# Optional: Base stack name used to derive AWS resource names
# stack_name = "guardian"
# stack_name = "psm"

# Required: ECR image URI for the server image
# After pushing to ECR, set this to the full image URI
server_image_uri = "123456789012.dkr.ecr.us-east-1.amazonaws.com/guardian-server:latest"

# Optional: Miden network for the deployed GUARDIAN server
# server_network_type = "MidenTestnet"

# Optional: Falcon public keys allowed to log in as dashboard operators.
# When set, Terraform creates <stack_name>/server/operator-public-keys.
# guardian_operator_public_keys = [
#   "0x<alice-falcon-public-key>",
#   "0x<bob-falcon-public-key>",
# ]

# Optional: existing Secrets Manager secret ARN containing a JSON array of Falcon public keys.
# When set, this takes precedence over guardian_operator_public_keys.
# guardian_operator_public_keys_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:guardian/operators"

# Optional: EVM runtime configuration when using Terraform directly.
# scripts/aws-deploy.sh derives these from config/evm/chains.json by default.
# guardian_evm_allowed_chain_ids = "1,11155111"
# guardian_evm_rpc_urls = "1=https://ethereum-rpc.publicnode.com,11155111=https://ethereum-sepolia-rpc.publicnode.com"
# guardian_evm_entrypoint_address = "0x433709009b8330fda32311df1c2afa402ed8d009"
# guardian_cors_allowed_origins = "https://accounts.openzeppelin.com"

# Optional: VPC and subnet configuration
# If not specified, uses the default VPC and all its subnets
# vpc_id     = "vpc-xxxxxxxx"
# subnet_ids = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]
# rds_proxy_subnet_ids = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]
# In us-east-1, avoid subnets in us-east-1e/use1-az3 for RDS Proxy.

# Optional: Postgres credentials
# Defaults derive from stack_name when omitted
# postgres_db       = "guardian"
# postgres_user     = "guardian"
# postgres_password = "guardian_dev_password"

# Optional: Managed RDS sizing overrides
# Stage defaults:
# - dev  -> db.t3.micro, 20 GiB allocated
# - prod -> db.r6g.large, 50 GiB allocated, 200 GiB max allocated
# rds_instance_class = "db.r6g.large"
# rds_allocated_storage = 50
# rds_max_allocated_storage = 200

# Optional: Managed RDS durability overrides
# Stage defaults:
# - dev  -> deletion protection off, final snapshot skipped on destroy
# - prod -> deletion protection on, final snapshot taken on destroy
# Multi-AZ is off in every stage unless enabled here.
# rds_backup_retention_days = 7
# rds_deletion_protection = true
# rds_skip_final_snapshot = false
# rds_multi_az = true

# Optional: Route 53 hosted zone ID
# route53_zone_id = "Z1234567890ABC"

# One-time hostname migration only; see ../docs/runbooks/guardian-domain-migration.md.
# Leave alias_subdomain empty for normal deployments.
# subdomain = "guardian-new"
# alias_subdomain = "guardian-old"
# alias_acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"

# Optional: Restrict ALB ingress (defaults to 0.0.0.0/0)
# alb_ingress_cidrs = ["203.0.113.0/24"]

# Optional: CloudWatch log retention
# log_retention_days = 7

# Optional: application metrics (ADOT sidecar + CloudWatch dashboard/alarms).
# Enabled by default; the metrics endpoint stays private to the ECS task.
# guardian_metrics_enabled = true   # server Prometheus endpoint (loopback-only)
# cloudwatch_metrics_enabled = true # ADOT sidecar + dashboard + alarms
# metrics_namespace = "Guardian/Server"
# alarm_actions = ["arn:aws:sns:us-east-1:123456789012:guardian-alerts"]
# alarm_error_rate_threshold_percent = 5
# alarm_latency_threshold_seconds = 1
# alarm_cpu_threshold_percent = 85
# alarm_memory_threshold_percent = 90

# Optional: Task resource configuration
# server_cpu    = 512
# server_memory = 1024

# Optional: rate limiting (HTTP and gRPC) and DB pool overrides
# guardian_rate_limit_enabled = false
# guardian_rate_burst_per_sec = 200
# guardian_rate_per_min = 5000
# guardian_db_pool_max_size = 32
# guardian_metadata_db_pool_max_size = 32
# guardian_canonicalization_fast_promotion_enabled = false

# Optional: Log format (text, json, compact) — json for CloudWatch Logs Insights
# guardian_log_format = "json"

# Optional: Resource naming (defaults match the original bash script)
# cluster_name                 = "guardian-cluster"
# server_service_name          = "guardian-server"
# alb_name                     = "guardian-alb"
# target_group_name            = "guardian-server-tg"
# alb_security_group_name      = "guardian-alb-sg"
# server_security_group_name   = "guardian-server-sg"
# postgres_security_group_name = "guardian-postgres-sg"
# task_execution_role_name     = "guardian-ecs-task-execution"
# task_role_name               = "guardian-ecs-task"
# server_task_family           = "guardian-server"
# server_container_name        = "guardian-server"
# server_log_group_name        = "/ecs/guardian-server"
