# Copy this file to infra/backend_override.tf (gitignored) to keep Terraform
# state in a remote backend instead of the per-stack local files that
# scripts/aws-deploy.sh uses by default.
#
# Terraform merges every *_override.tf file into the module, so the tracked
# configuration stays free of organisation-specific bucket names, account IDs
# and role ARNs. Select the stack with TF_WORKSPACE when running the deploy
# script; one workspace per STACK_NAME/DEPLOY_STAGE pair.

terraform {
  # Raises the module's own ">= 1.0" floor: use_lockfile below needs 1.10.
  required_version = ">= 1.10.0"

  backend "s3" {
    bucket               = "my-terraform-state-bucket"
    workspace_key_prefix = "environments"
    key                  = "guardian/terraform.tfstate"
    region               = "us-east-1"
    encrypt              = true
    use_lockfile         = true
  }
}

# Optional: run the AWS provider through a deployment role, for a cross-account
# deploy or to keep deploy rights off your own identity. The region and default
# tags from infra/versions.tf are kept; only assume_role is added.
#
# Before enabling this, note that it covers Terraform only. scripts/aws-deploy.sh
# talks to ECR, Secrets Manager and STS with your ambient credentials, not with
# this role. If the role is in another account, the image is pushed to one
# account's ECR while Terraform provisions in another, and the script's secret
# checks inspect the wrong account. Either keep your shell authenticated to the
# same account the role lives in, or use assume_role only to raise privileges
# within one account.
#
# provider "aws" {
#   assume_role {
#     role_arn = "arn:aws:iam::123456789012:role/Terraform"
#   }
# }
